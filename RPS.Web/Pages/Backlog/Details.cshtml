@page "/Detail/{id:int}/{screen?}"

@using RPS.Web.Models.Routing;
@model RPS.Web.Pages.Backlog.DetailsModel


<div>
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame-details d-flex flex-column align-items-start gap-2" style="width: 700px;">
                    <div class="page-title" id="itemTitle">@Model.Item.Title</div>
                </div>
            </div>
            <div class="col-auto">
                <div class="Tools d-flex gap-3">
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group mr-2">
                            <a href="/Detail/@Model.Item.Id" class="btn btn-light">Form</a>
                            <a href="/Detail/@Model.Item.Id/Tasks" class="btn btn-light">Tasks</a>
                            <a href="/Detail/@Model.Item.Id/Chitchat" class="btn btn-light">Chitchat</a>
                        </div>
        </div>
    </div>
</div>

@{
    switch (Model.Screen)
    {
        case DetailScreenEnum.Form:
            <partial name="_Details" model="@Model.DetailsFormVm" />
            break;
        case DetailScreenEnum.Tasks:
            <partial name="_Tasks" model="@Model.TasksFormVm" />
            break;
        case DetailScreenEnum.Chitchat:
            <partial name="_Chitchat" model="@Model.ChitchatFormVm" />
            break;
    }
}

@section styles {
    <link href="~/css/detail.css" rel="stylesheet" />
    <link href="~/css/chitchat.css" rel="stylesheet" />
}

@section scripts {
    <partial name="_TasksScripts" />
}