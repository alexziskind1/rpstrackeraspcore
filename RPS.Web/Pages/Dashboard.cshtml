@page
@model RPS.Web.Pages.DashboardModel

@{ 
    var userId = ViewData["userId"];
}

<div class="dashboard-page page">

    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="frame13 d-flex flex-column align-items-start gap-2">
                    <div class="page-title">Dashboard</div>
                </div>
            </div>

            <div class="col-auto">
                <div class="Tools d-flex gap-3">
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group mr-2">
                            <button type="button" class="btn btn-light" data-range="3" onclick="location.href = '/?months=3&userId=@userId'">
                                3 Months
                            </button>
                            <button type="button" class="btn btn-light" data-range="6" onclick="location.href = '/?months=6&userId=@userId'">
                                6 Months
                            </button>
                            <button type="button" class="btn btn-light" data-range="12" onclick="location.href = '/?months=12&userId=@userId'">
                                1 Year
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="container">
        <div class="DiagramAndStatistics">
            <div class="StatisticsBlock">
                <div class="active-issues-container">
                    <div class="numbers">
                        <div class="label-container">
                            <div class="base-input-label">
                                <div class="count-label color-default">
                                    @Model.IssueCountActive
                                </div>
                            </div>
                        </div>
                        <div class="label-full-width">
                            <div class="base-input-label">
                                <div class="text-label color-default">
                                    Active Issues
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="numbers">
                        <div class="label-container">
                            <div class="base-input-label">
                                <div class="count-label color-closed">
                                    @Model.IssueCountClosed
                                </div>
                            </div>
                        </div>
                        <div class="label-full-width">
                            <div class="base-input-label">
                                <div class="text-label color-closed">
                                    Closed Issues
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="numbers">
                        <div class="label-container">
                            <div class="base-input-label">
                                <div class="count-label color-open">
                                    @Model.IssueCountOpen
                                </div>
                            </div>
                        </div>
                        <div class="label-full-width">
                            <div class="base-input-label">
                                <div class="text-label color-open">
                                    Open Issues
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="numbers">
                        <div class="close-rate-container">
                            <div class="label-container">
                                <div class="base-input-label">
                                    <div class="count-label color-default">
                                        @Model.IssueCloseRate
                                    </div>
                                </div>
                            </div>
                            <div class="label-full-width">
                                <div class="base-input-label">
                                    <div class="text-label color-default">
                                        Close Rate
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="frame36 stretch-height">
                <div class="frame38">
                    <div class="Statistics left-stat-block">
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-heading">All Issues</div>
                            </div>
                        </div>
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-subheading">Active Issues</div>
                            </div>
                        </div>
                    </div>

                    <div class="Statistics right-stat-block">
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-subheading">
                                    Highest: 100% on Oct 11, 2025
                                </div>
                            </div>
                        </div>
                        <div class="Label inline-flex">
                            <div class="BaseInputLabel gap-6">
                                <div class="statistics-subheading">
                                    Lowest: 20% on Oct 9, 2025
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="frame36 chart-section">
                chart
            </div>
        </div>
    </div>

</div>



@section styles {
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/active-issues.css" rel="stylesheet" />
}


